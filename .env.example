# Petgram Environment Configuration Example
# Copy this file to .env for local full-stack development

# GEMINI_API_KEY: Required for live Gemini 3.8 Flash Veterinary First-Aid Triage.
# In AI Studio, this is automatically injected via the Secrets panel.
# For local development or production hosting, obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Server listener port (defaults to 3000)
PORT=3000

# APP_URL: The public hosted URL of your deployment (e.g. Cloud Run, Vercel, Render)
APP_URL="https://your-petgram-domain.com"

# GOOGLE_MAPS_API_KEY: Optional. For enhanced client-side Google Maps / Places autocomplete.
# If omitted, Petgram automatically provides verified directory listings + direct Google Maps navigation links.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_KEY_OPTIONAL"
